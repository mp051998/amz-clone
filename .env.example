# Copy to .env.local and fill in. See supabase/SETUP.md for where each value
# comes from (local: printed by `npx supabase start`; hosted: Project Settings → API).
# Add the same keys to Vercel (Project → Settings → Environment Variables).

# --- Supabase -------------------------------------------------------------
# Project URL (local: http://127.0.0.1:54321)                 (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key            (safe to expose — protected by row-level security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role / secret key  (SECRET — server only). Confirms card payments and
# releases reserved stock; those database functions are granted to this role only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode) ----------------------------------------------------
# Secret key (SECRET). Leave blank to hide card payments; other methods still work.
STRIPE_SECRET_KEY=

# Webhook signing secret (SECRET) for /api/v1/webhooks/stripe
# (local: printed by `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe`).
STRIPE_WEBHOOK_SECRET=

# --- AI layer (optional) ----------------------------------------------------
# Google Gemini API key (SECRET — server only). Optional: leave blank and every
# AI feature (query understanding, priority profile, review summaries, compare
# verdicts) falls back to deterministic rules. Get one at aistudio.google.com.
GEMINI_API_KEY=

# Model id (optional, default gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
