# Supabase — copy this file to .env.local and fill in the three values from your
# Supabase project (Dashboard → Project Settings → API). Add the same three to
# Vercel (Project → Settings → Environment Variables) for the deployed site.
#
# Until these are set, the app falls back to cookie-only mode (no DB, guest orders).

# Project URL, e.g. https://abcdefgh.supabase.co  (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key  (safe to expose — protected by row-level security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key  (SECRET — optional; not needed for the current features since
# row-level security runs every query as the signed-in user. Leave blank unless a
# future admin/back-office task needs to bypass RLS.)
SUPABASE_SERVICE_ROLE_KEY=
