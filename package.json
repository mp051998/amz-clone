{
  "name": "amz-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:types": "supabase gen types typescript --local > lib/db/database.types.ts",
    "db:reset": "supabase db reset",
    "db:seed:build": "node scripts/build-seed.mjs",
    "db:insights:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-insights.mjs",
    "admin:grant": "node --env-file=.env.local scripts/grant-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.1.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
